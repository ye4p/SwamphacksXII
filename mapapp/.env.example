# FastAPI origin, without /api. All auth and event requests use this base.
# Use localhost for both apps in development (do not mix localhost and 127.0.0.1).
VITE_API_BASE=http://localhost:8000
# Production example: https://api.swamp-search.us
# Set empty only when a same-origin proxy routes /auth/* and backend /api/*.
# Auth0 domain, client ID, secret, and callback are configured on the backend.
